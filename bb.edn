{:paths ["."]

 :tasks
 {test {:doc "Run the unit tests."
        :requires ([clojure.test :as t]
                   [methadone-test])
        :task (let [{:keys [fail error]} (t/run-tests 'methadone-test)]
                (System/exit (if (pos? (+ fail error)) 1 0)))}

  plot {:doc "Regenerate the README's plots."
        :requires ([plot])
        :task (plot/generate!)}}

 :aliases
 {:neil {:project {:version "0.3.0"}}}}
